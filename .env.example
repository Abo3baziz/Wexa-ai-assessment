# CognoDB connection (Bolt). Example:
# COGNODB_URI=bolt+s://db-xxxx.databases.cognodb.cloud
COGNODB_URI=

# CognoDB username is fixed by the managed service.
COGNODB_USERNAME=cognodb

# CognoDB instance password (never commit the real value).
COGNODB_PASSWORD=

# Optional: database name. CognoDB default is "neo4j".
COGNODB_DATABASE=neo4j
